import java.util.Arrays;

public class LCSMemoization {

    public static int lcs2(String s1,
                           String s2,
                           int n,
                           int m,
                           int dp[][]) {
 
        if(n == 0 || m == 0) {
            return 0;
        }

        if(dp[n][m] != -1) {
            return dp[n][m];
        }

        if(s1.charAt(n - 1)
            == s2.charAt(m - 1)) {

            return dp[n][m]
                = lcs2(
                    s1,
                    s2,
                    n - 1,
                    m - 1,
                    dp
                ) + 1;

        } else {

            int ans1 =
                lcs2(s1, s2,
                     n - 1, m, dp);

            int ans2 =
                lcs2(s1, s2,
                     n, m - 1, dp);

            return dp[n][m]
                = Math.max(ans1, ans2);
        }
    }

    public static void main(String[] args) {

        String s1 = "abcdge";
        String s2 = "abedg";

        int dp[][] =
            new int[s1.length()+1]
                   [s2.length()+1];

        for(int row[] : dp) {
            Arrays.fill(row, -1);
        }

        System.out.println(
            lcs2(
                s1,
                s2,
                s1.length(),
                s2.length(),
                dp
            )
        );
    }
}
